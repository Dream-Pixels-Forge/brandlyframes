{
  "name": "@brandlyframes/zod-types",
  "version": "1.1.0",
  "description": "Zod types and validation helpers shared across BrandlyFrames packages.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js --external:zod",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  },
  "keywords": ["brandlyframes", "zod", "types", "validation"],
  "license": "MIT"
}

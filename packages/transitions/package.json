{
  "name": "@brandlyframes/transitions",
  "version": "1.0.0",
  "description": "Transition components for BrandlyFrames (crossfade, slide, wipe, etc.)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "dev": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@brandlyframes/design": "workspace:*",
    "@brandlyframes/frames": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  },
  "keywords": [
    "brandlyframes",
    "transitions",
    "video",
    "react",
    "animation"
  ],
  "license": "MIT"
}
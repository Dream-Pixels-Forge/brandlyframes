{
  "name": "@brandlyframes/export-browser",
  "type": "module",
  "version": "1.1.0",
  "description": "BrandlyFrames browser-side video export via WebCodecs [BF-201]",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",

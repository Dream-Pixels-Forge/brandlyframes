{
  "name": "@brandlyframes/profiler",
  "type": "module",
  "version": "1.0.0",
  "description": "BrandlyFrames frame profiler — per-frame and per-component render timing with slow-frame report [BF-202]",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "vitest"
  },
  "dependencies": {
    "@brandlyframes/renderer-webgpu": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0",
    "@vitest/coverage-v8": "^5.0.4"
  },
  "keywords": ["brandlyframes", "profiler", "performance", "frame-timing", "flame-view"],
  "license": "MIT"
}

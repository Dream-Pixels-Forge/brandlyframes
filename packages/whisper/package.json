{
  "name": "@brandlyframes/whisper",
  "version": "1.0.0",
  "description": "speech-to-text transcription for BrandlyFrames",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "dev": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "brandlyframes": "workspace:*"
  },
  "devDependencies": {
    "@brandlyframes/design": "workspace:*",
    "@brandlyframes/frames": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "@vitest/coverage-v8": "^5.0.4"
  },
  "keywords": [
    "brandlyframes",
    "whisper",
    "video",
    "react"
  ],
  "license": "MIT"
}

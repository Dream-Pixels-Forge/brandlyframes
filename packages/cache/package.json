{
  "name": "@brandlyframes/cache",
  "version": "1.0.0",
  "description": "Content-addressed frame/layer render cache for BrandlyFrames: re-render only changed frames, shared across local, cloud and CI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vitest"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "brandlyframes": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.1.0"
  },
  "keywords": ["brandlyframes", "cache", "content-addressed", "render"],
  "license": "MIT"
}

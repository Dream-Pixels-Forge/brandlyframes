{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@brandlyframes/webcodecs": ["./packages/webcodecs/src/index.ts"],
      "@brandlyframes/zod-types": ["./packages/zod-types/src/index.ts"],
      "@brandlyframes/brand": ["./packages/brand/src/index.ts"],
      "@brandlyframes/mcp": ["./packages/mcp/src/index.ts"],
      "@brandlyframes/audio-reactive": ["./packages/audio-reactive/src/index.ts"],
      "@brandlyframes/fx": ["./packages/fx/src/index.ts"],
      "@brandlyframes/ai": ["./packages/ai/src/index.ts"],
      "@brandlyframes/interop": ["./packages/interop/src/index.ts"],
      "@brandlyframes/test": ["./packages/test/src/index.ts"]
    }
  }
}

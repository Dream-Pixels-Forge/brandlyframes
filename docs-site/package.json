{
  "name": "@brandlyframes/docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "BrandlyFrames documentation site — modern, premium docs with Cinema Black design system",
  "type": "module",
  "scripts": {
    "dev": "tsr generate && vite --port 4321 --open",
    "build": "tsr generate && tsc && vite build",

    "type-check": "tsr generate && tsc --noEmit"
  },
  "dependencies": {
    "@brandlyframes/design": "workspace:*",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-router": "^1.114.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@tanstack/router-cli": "^1.167.45",
    "@tanstack/router-devtools": "^1.114.0",
    "@tanstack/router-plugin": "^1.114.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.2.0"
  }
